# Copy to .env for `make run`. Values below match deploy/docker-compose.yml.
CHAINWATCH_RPC_URL=http://127.0.0.1:18545
CHAINWATCH_DATABASE_URL=postgres://chainwatch:chainwatch@127.0.0.1:55432/chainwatch?sslmode=disable
CHAINWATCH_HTTP_ADDR=127.0.0.1:8080
CHAINWATCH_LOG_LEVEL=info

CHAINWATCH_CONFIRMATIONS=2
CHAINWATCH_REORG_WINDOW=64
CHAINWATCH_MAX_BLOCK_RANGE=2000
CHAINWATCH_START_BLOCK=0
CHAINWATCH_POLL_INTERVAL=1s
CHAINWATCH_RPC_TIMEOUT=10s

# Risk rules
CHAINWATCH_DRAIN_WINDOW_BLOCKS=7200
# token=amount in base units, comma separated (here: 100 CWT on the demo token)
CHAINWATCH_LARGE_OUTFLOW=0x5FbDB2315678afecb367f032d93F642f64180aa3=100000000000000000000

# Notifications: a webhook OR Telegram; with neither, alerts are only logged.
CHAINWATCH_NOTIFY_INTERVAL=2s
CHAINWATCH_WEBHOOK_URL=
CHAINWATCH_TELEGRAM_BOT_TOKEN=
CHAINWATCH_TELEGRAM_CHAT_ID=
